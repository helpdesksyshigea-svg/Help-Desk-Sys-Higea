PORT=4000

# Proyecto de Supabase (Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=changeme

# Origen permitido para CORS (el dominio del frontend)
WEB_ORIGIN=http://localhost:5173

# Correo. Opción 1, SMTP (ej. Gmail con contraseña de aplicación). Si está, tiene prioridad.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=cuenta@gmail.com
SMTP_PASS=
MAIL_FROM=Mesa de ayuda SYS HIGEA <cuenta@gmail.com>

# Opción 2, Resend (requiere dominio propio verificado)
RESEND_API_KEY=
RESEND_FROM=
